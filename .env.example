# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-min

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_management_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_POOL_NAME=hms_pool
DB_POOL_SIZE=5

# Application Settings
APP_NAME=PulseCare HMS
APP_TIMEZONE=UTC
SESSION_COOKIE_SECURE=False
PERMANENT_SESSION_LIFETIME_DAYS=7
